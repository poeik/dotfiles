				<key>script</key>
				<string>#!/bin/bash

# Alfred Workflow Script to open new Ghostty window and enter query content
# This script simulates the key presses and types the query content

# it is a bit hack as it uses the ctrl+enter defined by aerospace to open a floating ghostty window
# Then it uses

# First, open new Ghostty floating window with Ctrl+Enter
osascript -e 'tell application "System Events" to key code 36 using {control down, shift down}'

# Small delay between key combinations
sleep 0.5

# Then create a new window. this closes the floating window and opens a new window on the current space
osascript -e 'tell application "System Events" to key code 45 using {command down}'

# Wait for the new window to fully load
sleep 0.5

# Type the query content into the terminal
if [ -n "{query}" ]; then
    osascript -e "tell application \"System Events\" to keystroke \"{query}\""
    
    # Press Enter to execute the command
    osascript -e 'tell application "System Events" to key code 36'
fi</string>
